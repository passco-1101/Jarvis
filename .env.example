# Copy this file to .env and fill in what you need. .env is git-ignored; never commit it.
# Anthropic key for plain-English requests. Without it, only raw commands starting with ! work.
ANTHROPIC_API_KEY=
# Model used to turn requests into commands.
JARVIS_MODEL=claude-sonnet-5-5
# Local port the daemon listens on (127.0.0.1 only).
JARVIS_PORT=8765
# Created automatically the first time Jarvis starts.
JARVIS_TOKEN=
